        {
          "name": "Forgot Password (OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    let sentEmail;",
                  "",
                  "    if (pm.request.body.mode === 'formdata') {",
                  "        sentEmail = pm.request.body.formdata.get(\"email\");",
                  "    } ",
                  "    else if (pm.request.body.mode === 'urlencoded') {",
                  "        sentEmail = pm.request.body.urlencoded.get(\"email\");",
                  "    }",
                  "    else if (pm.request.body.mode === 'raw') {",
                  "        let requestBody = JSON.parse(pm.request.body.raw);",
                  "        sentEmail = requestBody.email;",
                  "    }",
                  "    ",
                  "    if (sentEmail) {",
                  "        pm.environment.set(\"reset_email\", sentEmail);",
                  "        console.log(\"Email saved: \" + sentEmail);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "email",
                  "value": "",
                  "type": "text",
                  "uuid": "68910743-ff68-4a97-92ca-3397af651a28"
                }
